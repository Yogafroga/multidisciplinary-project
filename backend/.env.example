DB_NAME=""
# Имя базы данных, к которой будет подключаться приложение.

DB_USERNAME=""
# Пользователь базы данных с правами доступа к указанной базе.

DB_PASSWORD=""
# Пароль пользователя базы данных.

DB_HOST=""
# Хост базы данных (адрес сервера).

DB_PORT=
# Порт, на котором работает база данных.

SECRET_KEY=""
# Секретный ключ приложения.
# Используется для подписи JWT-токенов, шифрования данных, сессий и других механизмов безопасности.

# VK Cloud S3 Settings

VK_S3_BUCKET_NAME=""
# Имя S3-бакета в VK Cloud, используемого для хранения файлов (изображения, документы).

VK_S3_ACCESS_KEY_ID=""
# Access Key ID для доступа к S3-хранилищу VK Cloud.

VK_S3_SECRET_KEY=""
# Secret Access Key для доступа к S3-хранилищу VK Cloud.